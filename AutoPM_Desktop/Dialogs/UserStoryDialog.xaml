<Window x:Class="AutoPM_Desktop.Dialogs.UserStoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#0F172A"
        Title="User Story"
        Width="540" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTitle" Grid.Row="0" Text="Create User Story" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Text="Epic *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox x:Name="EpicCombo" DisplayMemberPath="Title" SelectedValuePath="Id" Margin="0,0,0,12"/>

                <TextBlock Text="Story (As a &lt;role&gt; I want &lt;goal&gt; so that &lt;benefit&gt;) *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="StoryBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                <TextBlock Text="Acceptance Criteria" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="AcceptanceBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Priority" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PriorityCombo"/>
                    </StackPanel>
                    <StackPanel x:Name="StatusPanel" Grid.Column="2">
                        <TextBlock Text="Initial Stage" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StatusCombo"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Assignees (Check team members)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ListBox x:Name="AssigneesList" Height="110" SelectionMode="Multiple" BorderBrush="#CBD5E1" DisplayMemberPath="DisplayName"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save Story" Style="{StaticResource PrimaryButton}" Width="125" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
