<Window x:Class="AutoPM_Desktop.Dialogs.SubTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#0F172A"
        Title="Create Sub-task"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Sub-task" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Sub-task Title *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" Margin="0,0,0,12"/>

            <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Assign To" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AssigneeCombo" DisplayMemberPath="DisplayName" SelectedValuePath="UserId"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Planned Effort (Hours)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="PlannedHoursBox" Text="2"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Priority" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PriorityCombo"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Due Date" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <DatePicker x:Name="EndDatePicker"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="BlockerCheck" Content="This sub-task is a blocker for its parent task" FontWeight="Medium" Foreground="#334155" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Add Sub-task" Style="{StaticResource PrimaryButton}" Width="125" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
