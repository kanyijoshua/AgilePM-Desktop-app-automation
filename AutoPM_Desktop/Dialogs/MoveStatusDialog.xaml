<Window x:Class="AutoPM_Desktop.Dialogs.MoveStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{materialDesign:MaterialDesignFont}"
        TextElement.Foreground="#0F172A"
        Title="Move Stage &amp; Log Hours"
        Width="440" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Target Workflow Stage" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <ComboBox x:Name="StageCombo" SelectionChanged="StageCombo_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Hours Worked to Log (manHours)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
            <TextBox x:Name="HoursBox" Text="0"/>
        </StackPanel>

        <Border x:Name="AutoStepNotice" Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Visibility="Collapsed">
            <TextBlock Text="ℹ Note: Agile PM requires Planned tasks to pass through InProgress first. This app will automatically step through InProgress for you."
                       FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Move &amp; Save" Style="{StaticResource PrimaryButton}" Width="120" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
