<UserControl x:Class="AutoPM_Desktop.Views.TaskPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AutoPM_Desktop.Views">
    <DockPanel Margin="16,14">
        <!-- Input -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Describe the work; the AI turns it into tasks" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="ScopeText" FontSize="12" Foreground="#64748B" Margin="0,2,0,10" TextWrapping="Wrap"
                       Text="Paste requirements, meeting notes or a feature idea. Tasks are matched to the active project's user stories. Nothing is created until you press Create."/>
            <local:ProjectFolderBar x:Name="FolderBar" Margin="0,0,0,10"/>
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     materialDesign:HintAssist.Hint="e.g. Users must be able to reset their password by email; the link expires after an hour, and admins see a log of resets."/>
            <WrapPanel Margin="0,10,0,0">
                <StackPanel Margin="0,0,10,6" Width="240">
                    <TextBlock Text="Match to stories in" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="EpicCombo" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6" Width="210">
                    <TextBlock Text="Assign to" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="AssignModeCombo" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,6" Width="96">
                    <TextBlock Text="Due in (days)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DueDaysBox" Text="7"/>
                </StackPanel>
                <Button x:Name="DraftBtn" Content="✨ Draft tasks" Style="{StaticResource AiButton}" VerticalAlignment="Bottom" Margin="0,0,8,6"
                        Click="Draft_Click" ToolTip="Ask the AI for tasks (Ctrl+Enter in the description)"/>
            </WrapPanel>
            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Margin="0,4,0,4" Visibility="Hidden"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="CreateBtn" DockPanel.Dock="Right" Content="Create selected tasks" Style="{StaticResource PrimaryButton}"
                    Click="Create_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Clear_Click"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Review grid -->
        <Grid>
            <DataGrid x:Name="DraftGrid" IsReadOnly="False" CanUserSortColumns="False" RowHeight="44" SelectionUnit="FullRow"
                      CellEditEnding="DraftGrid_CellEditEnding" Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Create" Width="62">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Create, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          Click="RowCheck_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2.2*"/>
                    <DataGridTextColumn Header="Hours" Binding="{Binding Hours, UpdateSourceTrigger=LostFocus}" Width="64"/>
                    <DataGridTemplateColumn Header="Priority" Width="104">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Priorities, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="6,3" materialDesign:TextFieldAssist.TextFieldCornerRadius="6"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="User story" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.StoryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding StoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="6,3" materialDesign:TextFieldAssist.TextFieldCornerRadius="6"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Assignee" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.MemberOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Id"
                                          SelectedValue="{Binding AssigneeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="6,3" materialDesign:TextFieldAssist.TextFieldCornerRadius="6"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Due" Width="128">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Due, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="ToolTip" Value="{Binding Description}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Foreground="#94A3B8" FontSize="12.5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="460" TextAlignment="Center"
                       Text="Drafted tasks appear here for review: edit titles, hours, stories or assignees, untick any you don't want, then create them in one go."/>
        </Grid>
    </DockPanel>
</UserControl>
