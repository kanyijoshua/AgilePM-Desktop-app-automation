<UserControl x:Class="AutoPM_Desktop.Views.QuickUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="16,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Update your tasks in plain words" FontSize="15" FontWeight="Bold"/>
            <TextBlock x:Name="ScopeText" FontSize="12" Foreground="#64748B" Margin="0,2,0,10" TextWrapping="Wrap"
                       Text="Say what you did or want changed. The AI finds the matching tasks in the active project and proposes the moves, hours and comments; you tick what to apply."/>
            <!-- Project folder: recent commits / changed files become the update -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <DockPanel>
                    <Button x:Name="ReadFolderBtn" DockPanel.Dock="Right" Content="⇩ Read what's been done" Style="{StaticResource SecondaryButton}"
                            Click="ReadFolder_Click" IsEnabled="False"
                            ToolTip="Reads your commits (or changed files) in the period and asks the AI to match them to your tasks"/>
                    <ComboBox x:Name="SinceCombo" DockPanel.Dock="Right" Width="132" Margin="8,0" SelectedIndex="1" VerticalAlignment="Center">
                        <ComboBoxItem Content="Today" Tag="0"/>
                        <ComboBoxItem Content="Since yesterday" Tag="1"/>
                        <ComboBoxItem Content="Last 3 days" Tag="3"/>
                        <ComboBoxItem Content="Last 7 days" Tag="7"/>
                        <ComboBoxItem Content="Last 14 days" Tag="14"/>
                    </ComboBox>
                    <Button DockPanel.Dock="Right" Content="📁 Choose folder…" Style="{StaticResource GhostButton}" Click="ChooseFolder_Click"
                            ToolTip="The local code folder (git repository) for this project; remembered per project"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Project folder" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="FolderText" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"
                                   Text="None chosen. Pick this project's code folder to turn your recent commits into task updates."/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBox x:Name="UpdateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     materialDesign:HintAssist.Hint="e.g. Finished the login API, log 3h. Started the password reset email. Comment on the token service: waiting for the SMTP keys."/>
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="WorkOutBtn" DockPanel.Dock="Right" Content="✨ Work out the changes" Style="{StaticResource AiButton}"
                        Click="WorkOut_Click" ToolTip="Ctrl+Enter in the text box"/>
                <CheckBox x:Name="OnlyMineCheck" Content="Only my tasks" IsChecked="True" VerticalAlignment="Center"
                          ToolTip="Off: match against every open task in the project"/>
            </DockPanel>
            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Margin="0,8,0,4" Visibility="Hidden"/>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Content="Apply selected" Style="{StaticResource SuccessButton}"
                    Click="Apply_Click" IsEnabled="False"/>
            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Clear_Click"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="ActionsGrid" IsReadOnly="False" CanUserSortColumns="False" RowHeight="40" Visibility="Collapsed">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Apply" Width="58">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          Click="RowCheck_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Task" Binding="{Binding TaskTitle}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Now" Binding="{Binding CurrentStage}" IsReadOnly="True" Width="92"/>
                    <DataGridTextColumn Header="Change" Binding="{Binding ChangeText}" IsReadOnly="True" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Hours" Binding="{Binding Hours, UpdateSourceTrigger=LostFocus}" Width="64"/>
                    <DataGridTextColumn Header="Why" Binding="{Binding Reason}" IsReadOnly="True" Width="1.6*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Foreground="#94A3B8" FontSize="12.5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="460" TextAlignment="Center"
                       Text="Proposed changes appear here. Nothing changes in Agile PM until you press Apply."/>
        </Grid>
    </DockPanel>
</UserControl>
